// Beyond Borders — admin/API database schema.
// This project is the sole owner of the database. The public web app never
// connects to Postgres; it reaches this data through /api/v1.
//
// Phase 0 covers identity, sessions, settings and audit. Later phases add
// catalog, packages, planner, itineraries, quotes, commerce and past trips.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
//
// Travellers and staff live in SEPARATE tables, signed with separate JWT
// secrets. There is deliberately no `isAdmin` flag on a user: privilege cannot
// be gained by mutating a row the user can influence.
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AdminRole {
  SUPER_ADMIN // full access, including managing other admins
  OPS // quotes, bookings, payments, departures
  CONTENT // packages, trips, polls, media moderation
  SUPPORT // read-only plus replying to inquiries
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Always stored lowercased and trimmed — normalise via normalizeEmail()
  /// before any read or write, since Postgres unique indexes are case-sensitive.
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?

  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Exempt from every entitlement ceiling: days per itinerary, saved
  /// itineraries, itineraries per period, AI prompts per period.
  ///
  /// A COLUMN RATHER THAN AN ENV ALLOWLIST, and the difference matters. A list
  /// of privileged addresses in the environment is invisible to the console,
  /// needs a redeploy to change, and would quietly re-grant privilege to
  /// whoever later registers one of those addresses. A row is auditable,
  /// revocable without a deploy, and belongs to exactly one account.
  ///
  /// THIS IS NOT AN ADMIN FLAG. It grants nothing staff-only — staff live in a
  /// separate table signed with a separate JWT secret, and that separation is
  /// the thing stopping privilege being gained by mutating a user row. All this
  /// removes is metering.
  unlimited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens      UserRefreshToken[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]

  subscriptions   Subscription[]
  usageCounters   UsageCounter[]
  payments        Payment[]
  plannerSessions PlannerSession[]
  itineraries     Itinerary[]
  /// Anonymous visitors that later became this account.
  convertedFrom   AnonymousVisitor[]
  /// Quotes requested. SetNull, so the commercial record survives deletion.
  quotes          Quote[]

  /// Detached rather than cascaded — see each model for why. Spend survives a
  /// deleted account, a poll's totals must not silently drop, and an interest
  /// list ops is working from is not the account's to erase.
  aiUsageEvents    AiUsageEvent[]
  pollVotes        PollVote[]
  packageInterests PackageInterest[]

  /// Past trips. `tripReviews` cascades — an account's opinions go with it —
  /// while participation and uploaded photographs detach: the trip still ran
  /// with that many people, and an approved gallery photo is the trip's record
  /// rather than the uploader's property.
  tripParticipations TripParticipant[]
  tripReviews        TripReview[]
  tripMedia          TripMedia[]

  /// Commerce. Both detach rather than cascade: a booking is a financial record
  /// and a redemption is the evidence a coupon ceiling was consumed.
  bookings          PackageBooking[]
  couponRedemptions CouponRedemption[]
  journeys          Journey[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model AdminUser {
  id String @id @default(uuid(7)) @db.Uuid

  email        String  @unique
  passwordHash String
  name         String
  avatarUrl    String?

  role   AdminRole
  status AdminStatus @default(ACTIVE)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens AdminRefreshToken[]
  auditLogs     AuditLog[]
  settings      Setting[]

  /// What this staff member let onto the public site. Named relations because
  /// AdminUser is referenced twice from two different moderation queues.
  moderatedMedia   TripMedia[]      @relation("TripMediaModerator")
  moderatedReviews TripReview[]     @relation("TripReviewModerator")
  reviewedPlaces   PlaceCandidate[]

  @@index([role])
  @@index([status])
  @@map("admin_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sessions
//
// Refresh tokens rotate on every use. We store only a SHA-256 hash, so a
// database leak does not yield usable tokens.
//
// `familyId` groups every token descended from one login. When a token that has
// already been rotated is presented again, that means a copy leaked — we revoke
// the whole family rather than just the replayed token.
// ─────────────────────────────────────────────────────────────────────────────

model UserRefreshToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the raw token. The raw value is returned to the client once and
  /// never persisted.
  tokenHash String @unique

  /// Shared by every token descended from a single login.
  familyId String @db.Uuid

  expiresAt DateTime

  /// Absolute deadline for the whole family, fixed at login and copied
  /// unchanged onto every successor. Without it, rotation slides `expiresAt`
  /// forward on each use, so a stolen token refreshed once a month would grant
  /// access forever without the password ever being re-entered.
  familyExpiresAt DateTime

  revokedAt DateTime?

  /// Set when this token is rotated, forming the chain used for reuse detection.
  replacedByTokenId String?           @unique @db.Uuid
  replacedByToken   UserRefreshToken? @relation("UserTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          UserRefreshToken? @relation("UserTokenRotation")

  /// Truncated UA string and a salted hash of the IP — enough to spot anomalies
  /// without storing raw addresses.
  userAgent String?
  ipHash    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("user_refresh_tokens")
}

model AdminRefreshToken {
  id String @id @default(uuid(7)) @db.Uuid

  adminUserId String    @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  familyId  String @db.Uuid

  expiresAt DateTime

  /// Absolute deadline for the family. See UserRefreshToken.familyExpiresAt —
  /// staff sessions need this bound at least as much as travellers', since
  /// there is no admin self-service password reset to fall back on.
  familyExpiresAt DateTime

  revokedAt DateTime?

  replacedByTokenId String?            @unique @db.Uuid
  replacedByToken   AdminRefreshToken? @relation("AdminTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          AdminRefreshToken? @relation("AdminTokenRotation")

  userAgent String?
  ipHash    String?

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Account lifecycle tokens
//
// Also hashed at rest, also single-use. Requesting a reset for an unknown email
// must still return success at the API layer, so these tables are never used to
// probe which addresses are registered.
// ─────────────────────────────────────────────────────────────────────────────

model PasswordReset {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  ipHash    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model EmailVerification {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The address being verified — recorded separately so a pending change of
  /// email cannot be confirmed onto a different address than it was issued for.
  email String

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Operations
// ─────────────────────────────────────────────────────────────────────────────

/// Runtime configuration editable from the admin console without a redeploy:
/// payment instructions, company details, AI model choice, feature flags.
model Setting {
  key         String  @id
  value       Json
  description String?
  /// Settings marked public are safe to expose through the API to the website.
  isPublic    Boolean @default(false)

  updatedAt        DateTime   @updatedAt
  updatedByAdminId String?    @db.Uuid
  updatedByAdmin   AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@map("settings")
}

model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// Who acted. Both null means the action was taken by the system itself.
  adminUserId String?    @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  userId      String?    @db.Uuid

  /// Verb in past tense, e.g. "quote.sent", "package.published".
  action     String
  entityType String
  entityId   String?

  /// Field-level snapshots. Never store password hashes or raw tokens here.
  before Json?
  after  Json?

  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminUserId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing & entitlements
//
// Every amount in this file is whole Bangladeshi taka stored as Int. There is
// no minor unit in circulation (the poisha is dead), and float money in a
// planner that sums dozens of block costs would drift visibly. USD is a display
// convenience computed from the admin-set `bdtPerUsd` setting; it is never
// stored.
//
// A null on a Plan limit means UNLIMITED, not zero. Enforcement code must test
// `limit === null` before comparing, or the most expensive tier becomes the
// most restrictive one.
// ─────────────────────────────────────────────────────────────────────────────

/// The whole price list. Three tiers, and deliberately no fourth.
///
/// UNLOCK_SINGLE — a 200 BDT one-off that opened a single itinerary forever —
/// was removed rather than hidden. It was the only non-subscription product,
/// so it carried its own payment purpose, its own grant table and its own
/// branch in settlement: a second commerce path maintained forever for one
/// price point. Nothing had been sold through it, so it left cleanly.
enum PlanCode {
  FREE // logged in, 2-day itineraries, 3 saved
  PREMIUM_5 // 500 BDT/month, 5 itineraries a month
  PREMIUM_100 // 5000 BDT/month, 100 itineraries a month
}

enum BillingInterval {
  NONE // one-off purchase or the free tier
  MONTHLY
}

enum SubscriptionStatus {
  PENDING // created, payment not yet settled
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentProvider {
  BKASH
  SSLCOMMERZ
  MANUAL_BANK // large trip bookings settled by bank transfer

  /// The sandbox gateway. Moves no money and settles on a button press, so the
  /// purchase flows can be exercised end to end before a merchant account
  /// exists. Every row it writes carries `isTest = true`, and it refuses to run
  /// under NODE_ENV=production unless two independent environment flags both
  /// say otherwise — see server/payments/mock.ts.
  MOCK
}

enum PaymentPurpose {
  SUBSCRIPTION
  BOOKING
}

enum PaymentStatus {
  INITIATED // row created before the user was sent to the gateway
  PENDING // gateway acknowledged, awaiting callback
  SUCCEEDED
  FAILED
  REFUNDED
}

/// A sellable entitlement tier. Rows are seeded and edited from the admin
/// console; code reads them by `code`, never by id, so seeding order is free.
model Plan {
  id String @id @default(uuid(7)) @db.Uuid

  code        PlanCode @unique
  name        String
  description String

  priceBdt Int
  interval BillingInterval @default(NONE)

  /// null = unlimited on all four. FREE is 3 / 2 / null / 30.
  maxSavedItineraries  Int?
  maxItineraryDays     Int?
  itinerariesPerPeriod Int?

  /// AI planner turns per period, metered against UsageCounter.aiPromptsUsed.
  ///
  /// Separate from `itinerariesPerPeriod` because the two meter different
  /// things: an itinerary is the product, a prompt is the spend. Without this
  /// column a FREE account — which is deliberately unmetered per period, since
  /// its 3-saved ceiling bounds what it can KEEP — has nothing at all bounding
  /// what it can ASK, and every planner turn is a paid model call. `null` means
  /// unmetered and is reserved for tiers we are happy to leave uncapped.
  aiPromptsPerPeriod Int?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  /// Checkouts opened against this plan, settled or not. Also what makes the
  /// Restrict on Payment.planId bite.
  payments      Payment[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

model Subscription {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(PENDING)

  startedAt DateTime @default(now())

  /// Also the reset boundary for the matching UsageCounter period.
  currentPeriodEnd DateTime

  /// Set when the user cancels. The subscription still runs to
  /// `currentPeriodEnd` — cancelling is not a refund.
  cancelledAt DateTime?

  /// Unique: one settled payment funds exactly one period. A renewal is a new
  /// payment and a new row, so a replayed callback cannot extend two periods.
  paymentId String?  @unique @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

/// Consumption within one billing period. Kept separate from Subscription so
/// that free users — who have no subscription row — are still metered, and so
/// that history survives a plan change.
model UsageCounter {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  itinerariesCreated Int @default(0)
  aiPromptsUsed      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Lets the meter be an upsert-then-increment, which is race-free under
  /// concurrent generation requests.
  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
  @@map("usage_counters")
}

/// One row per payment attempt, across every provider. `userId` is nullable and
/// detaches rather than cascades: a deleted account must not erase the
/// financial record.
model Payment {
  id String @id @default(uuid(7)) @db.Uuid

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  provider PaymentProvider
  purpose  PaymentPurpose

  /// What this payment is FOR, resolved at checkout and never afterwards.
  ///
  /// `settle()` is handed a payment id and nothing else — that is the shape
  /// every real gateway callback arrives in, since the gateway knows our
  /// reference and not our domain. So the target of the purchase has to be on
  /// the payment itself, decided when the amount was decided, or a settlement
  /// has no way to know what it just paid for.
  ///
  /// The grant row points back here (`Subscription.paymentId`), so after
  /// settlement the link exists in both
  /// directions: this column records what was BOUGHT, those record what was
  /// GRANTED, and a mismatch between them is detectable rather than invisible.
  ///
  /// Exactly one is set, chosen by `purpose`. Both null for BOOKING, which ops
  /// settles by hand against a quote rather than against a row here.
  itineraryId String?    @db.Uuid
  itinerary   Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: SetNull)

  /// Restrict rather than SetNull: a plan with payments against it is a plan
  /// that was sold, and deleting the row out from under the financial record
  /// would leave "they paid 990 BDT for something" with no way to say what.
  /// Plans are retired with `isActive = false`, never deleted.
  planId String? @db.Uuid
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: Restrict)

  /// Set for `purpose = BOOKING`, and the reason that purpose is no longer
  /// inert. Restrict, like the plan: a booking with a settled payment against
  /// it is a trip somebody paid for.
  ///
  /// The comment above this block used to say both targets were null for a
  /// BOOKING because ops settled those by hand against a quote. That is still
  /// true of a quote-driven booking; a package departure bought through
  /// self-service checkout points here instead.
  bookingId String?         @db.Uuid
  booking   PackageBooking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  amountBdt Int
  status    PaymentStatus @default(INITIATED)

  /// True when no money moved — a row written by the sandbox gateway.
  ///
  /// This is a revenue-integrity column, not a debugging convenience. A mock
  /// settlement grants a real entitlement, so its Payment row is
  /// indistinguishable from a paid one in every other field: same provider
  /// mechanics, same amount, same SUCCEEDED status, same grant behind it. Without a flag on the row itself, a revenue query written six months
  /// from now would sum sandbox traffic as income, and no amount of care about
  /// which provider values "look real" would catch it — MANUAL_BANK is also
  /// settled by hand and is genuinely income.
  ///
  /// Defaults false so every existing row, and every future real gateway, is
  /// income unless something explicitly says otherwise. Reporting filters
  /// `isTest = false`; the admin console badges the true ones loudly.
  isTest Boolean @default(false)

  /// The provider's own transaction id (bKash trxID, SSLCommerz val_id, or the
  /// bank reference typed in by ops).
  providerRef String?

  /// Supplied by the caller and unique across all providers. Gateways retry
  /// callbacks; without this a double-fire charges or grants twice.
  idempotencyKey String @unique

  /// Verbatim provider callback, kept for dispute resolution. Never trusted as
  /// the source of truth for `status` or `amountBdt`.
  rawPayload Json?

  createdAt DateTime  @default(now())
  settledAt DateTime?
  updatedAt DateTime  @updatedAt

  subscription Subscription?

  @@index([userId, status])
  @@index([provider, providerRef])
  @@index([status, createdAt])
  /// Both readers of `isTest` scan in recency order: the admin list with test
  /// rows filtered out, and any revenue report over a date range. Leading with
  /// the flag lets both skip the sandbox rows without touching them.
  @@index([isTest, createdAt])
  /// "Has this traveller already paid for this trip?" — asked by every unlock
  /// checkout before it opens a second one.
  @@index([itineraryId])
  @@index([planId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Anonymous access & abuse control
//
// An anonymous visitor gets exactly one AI prompt, ever. Identity is the union
// of three weak signals — signed cookie, hashed IP, hashed device fingerprint —
// and a hit on ANY ONE of them is the same visitor. Cookie clearing, incognito
// and a fresh fingerprint each defeat one signal alone; they do not defeat the
// union.
//
// Raw IPs are never stored, only salted hashes, so this table cannot be turned
// into a location log.
// ─────────────────────────────────────────────────────────────────────────────

model AnonymousVisitor {
  id String @id @default(uuid(7)) @db.Uuid

  /// Value inside the signed cookie. Unique because it is the strongest of the
  /// three signals and the one we mint ourselves.
  cookieId String @unique

  ipHash          String
  fingerprintHash String

  promptsUsed Int @default(0)

  firstSeenAt DateTime @default(now())
  /// Written explicitly on each visit, not via @updatedAt, so that bumping an
  /// unrelated column does not forge activity.
  lastSeenAt  DateTime @default(now())

  /// Set when this visitor registers. Their teaser session is then adopted by
  /// the account instead of being thrown away.
  convertedUserId String? @db.Uuid
  convertedUser   User?   @relation(fields: [convertedUserId], references: [id], onDelete: SetNull)

  plannerSessions PlannerSession[]
  aiUsageEvents   AiUsageEvent[]
  pollVotes       PollVote[]

  /// Non-unique by design: many visitors share an IP (NAT, mobile carriers) and
  /// many share a fingerprint (same phone model, same browser). These are
  /// lookup indexes for the "any signal matches" query, not identities.
  @@index([ipHash])
  @@index([fingerprintHash])
  @@index([convertedUserId])
  @@map("anonymous_visitors")
}

/// Teaser replies keyed on the four questionnaire answers. The anonymous reply
/// is generated from a fixed questionnaire, not free-form chat, so the input
/// space is small and cacheable. Bypass attempts — new cookie, new device —
/// therefore cost no AI spend at all, which is the whole point of caching here
/// rather than trusting the visitor table alone.
model TeaserCache {
  id String @id @default(uuid(7)) @db.Uuid

  /// sha256 of `destination|days|partySize|purpose`, each normalised
  /// (trimmed, lowercased, whitespace collapsed) before hashing.
  cacheKey String @unique

  payload  Json
  hitCount Int  @default(0)

  createdAt DateTime  @default(now())
  lastHitAt DateTime?

  @@index([hitCount])
  @@map("teaser_cache")
}

/// Fixed-window counters for the rate limiter in server/http/rate-limit.ts.
///
/// In Postgres rather than in a Map, because a Map is per process. Two
/// instances behind a load balancer would grant two allowances, an autoscaler
/// grants one per new pod, and a cold start resets the count to zero — a limit
/// an attacker multiplies by retrying is not a limit. Shared state is the whole
/// requirement, and the database is the shared state we already have.
model RateLimitBucket {
  id String @id @default(uuid(7)) @db.Uuid

  /// What is being limited, e.g. `teaser:ip:<digest>`. Never a raw address:
  /// this table would otherwise become a log of who asked for what and when,
  /// for the same people the limiter exists to meter rather than to watch.
  bucketKey String

  /// Start of the window this row counts, floored to the window length.
  windowStart DateTime

  /// Hits in this window, including refused ones — hammering a closed window
  /// must not shorten it.
  hits Int @default(0)

  createdAt DateTime @default(now())

  /// One row per key per window. The upsert-and-increment in rate-limit.ts is
  /// atomic only because this constraint gives the conflict an unambiguous
  /// target; without it two concurrent requests each insert a row and the
  /// counter reads 1 twice instead of 2.
  @@unique([bucketKey, windowStart])
  /// Pruning old windows reads this and nothing else.
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog
//
// The AI is grounded on these tables and may only recommend rows that exist
// here. It is a salesperson for real, sellable inventory, not a travel writer:
// an invented activity is a defect, because ops cannot book it and the price is
// fiction.
// ─────────────────────────────────────────────────────────────────────────────

enum ActivityCategory {
  SIGHTSEEING
  ADVENTURE
  WATER_SPORTS
  CULTURE
  FOOD
  WELLNESS
  NIGHTLIFE
  SHOPPING
  NATURE
  TRANSPORT
}

enum TimeOfDay {
  ANY
  EARLY_MORNING
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum ActivityIntensity {
  RELAXED
  MODERATE
  ACTIVE
}

model Destination {
  id String @id @default(uuid(7)) @db.Uuid

  slug    String  @unique
  name    String
  country String
  region  String?
  summary String

  heroImageUrl String?

  /// Decimal(9,6) holds ±180.000000 exactly: ~11 cm of precision, and no
  /// binary-float rounding when a coordinate makes a round trip through JSON.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// IANA zone, e.g. "Asia/Dhaka". Every minutes-from-midnight value in an
  /// itinerary for this destination is local time in this zone.
  timezone String

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities      Activity[]
  placeCandidates PlaceCandidate[]
  itineraries     Itinerary[]
  packages        TravelPackage[]

  @@index([isActive, sortOrder])
  @@index([country])
  @@map("destinations")
}

model Activity {
  id String @id @default(uuid(7)) @db.Uuid

  slug String @unique

  destinationId String      @db.Uuid
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  name        String
  /// One line for cards and for the AI's shortlist prompt.
  summary     String
  /// Full prose for the detail view.
  description String

  category ActivityCategory

  /// Excludes travel to and from. The planner adds TRANSIT blocks for that.
  durationMinutes Int

  /// null means "price on request" — free sights and anything ops quotes case
  /// by case. `priceNote` carries the nuance ("entry only", "per boat").
  pricePerPersonBdt Int?
  priceNote         String?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  bestTimeOfDay TimeOfDay @default(ANY)

  minPartySize Int?
  maxPartySize Int?

  intensity       ActivityIntensity @default(MODERATE)
  bookingRequired Boolean           @default(false)

  isActive  Boolean @default(true)
  /// Where the curator verified price and hours, for the next content review.
  sourceUrl String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ActivityImage[]
  tags           ActivityTag[]
  openingHours   ActivityOpeningHours[]
  blocks         ItineraryBlock[]
  /// Set when this activity came from an approved Google Places import.
  placeCandidate PlaceCandidate?
  journeyItems   JourneyItem[]

  @@index([destinationId, isActive])
  @@index([category])
  @@index([destinationId, category, isActive])
  @@map("activities")
}

model ActivityImage {
  id String @id @default(uuid(7)) @db.Uuid

  activityId String   @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  url String
  /// Required, not optional: an image with no alt text is inaccessible, and
  /// making the column nullable guarantees someone ships one.
  alt String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([activityId, sortOrder])
  @@map("activity_images")
}

/// Interest vocabulary used to match a trip brief to inventory: snorkelling,
/// temples, street food, and so on.
model Tag {
  id String @id @default(uuid(7)) @db.Uuid

  slug  String @unique
  label String

  createdAt DateTime @default(now())

  activities ActivityTag[]

  @@map("tags")
}

model ActivityTag {
  activityId String   @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  tagId String @db.Uuid
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([activityId, tagId])
  @@index([tagId])
  @@map("activity_tags")
}

/// Opening hours as minutes from local midnight, matching ItineraryBlock so
/// that "is this activity open during this block" is integer comparison.
///
/// Convention: an activity with NO rows at all is always available (a public
/// beach, a viewpoint). Once an activity has any row, a weekday with no row is
/// CLOSED that day. `closesMinute` may exceed 1440 for venues that run past
/// midnight — 1560 is 02:00 the next morning.
model ActivityOpeningHours {
  id String @id @default(uuid(7)) @db.Uuid

  activityId String   @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday, matching JavaScript's getDay().
  dayOfWeek Int

  opensMinute  Int
  closesMinute Int

  /// Not unique on (activityId, dayOfWeek): venues with a midday break need two
  /// windows on the same day.
  @@index([activityId, dayOfWeek])
  @@map("activity_opening_hours")
}

// ─────────────────────────────────────────────────────────────────────────────
// Planner
// ─────────────────────────────────────────────────────────────────────────────

enum PlannerSessionStatus {
  ACTIVE
  CONVERTED // became a saved itinerary
  ABANDONED
}

enum PlannerMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

/// One planning conversation. Owned by EXACTLY ONE of a user or an anonymous
/// visitor — never both, never neither. The database enforces this with a CHECK
/// constraint added in the migration, because Prisma cannot express it and
/// "the service layer always sets one" is not a constraint.
model PlannerSession {
  id String @id @default(uuid(7)) @db.Uuid

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  anonymousVisitorId String?           @db.Uuid
  anonymousVisitor   AnonymousVisitor? @relation(fields: [anonymousVisitorId], references: [id], onDelete: Cascade)

  status PlannerSessionStatus @default(ACTIVE)

  /// The structured brief: destination, days, party size, purpose, interests,
  /// budget. Json rather than columns because it is the model's input contract
  /// and will gain fields faster than migrations are worth.
  tripBrief Json

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages      PlannerMessage[]
  itineraries   Itinerary[]
  aiUsageEvents AiUsageEvent[]

  @@index([userId])
  @@index([anonymousVisitorId])
  @@index([status, lastMessageAt])
  @@map("planner_sessions")
}

model PlannerMessage {
  id String @id @default(uuid(7)) @db.Uuid

  sessionId String         @db.Uuid
  session   PlannerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    PlannerMessageRole
  content String

  /// Tool invocations and their results, for replaying how a recommendation
  /// was reached — chiefly which catalog rows were retrieved.
  toolCalls Json?

  /// Recorded per message, not per session: the configured model can change
  /// mid-conversation, and cost attribution must survive that.
  model            String?
  promptTokens     Int?
  completionTokens Int?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("planner_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Itineraries
//
// Times are Int minutes from local midnight rather than DateTime. Two blocks
// overlap iff `aStart < bEnd && bStart < aEnd` — plain integer arithmetic, no
// timezone, no DST, and the Gantt renders straight from these numbers.
// ─────────────────────────────────────────────────────────────────────────────

enum TripPurpose {
  VACATION
  BUSINESS
  HONEYMOON
  FAMILY
  SOLO
  GROUP
  OTHER
}

enum TripPace {
  RELAXED
  BALANCED
  PACKED
}

enum TransportPreference {
  PRIVATE_CAR
  SELF_DRIVE
  PUBLIC_TRANSIT
  WALKING
  MIXED
}

enum BudgetBand {
  BUDGET
  MID_RANGE
  PREMIUM
  LUXURY
}

enum ItineraryStatus {
  DRAFT
  SAVED
  SUBMITTED // sent to ops for a quote
  QUOTED
  ACCEPTED
  BOOKED
  COMPLETED
  CANCELLED
}

enum ItineraryBlockKind {
  ACTIVITY
  TRANSIT
  MEAL
  REST
  FREE
  ACCOMMODATION
}

enum TransitMode {
  WALK
  CAR
  TAXI
  RIDESHARE
  BUS
  TRAIN
  FERRY
  BOAT
  FLIGHT
  BICYCLE
}

model Itinerary {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plannerSessionId String?         @db.Uuid
  plannerSession   PlannerSession? @relation(fields: [plannerSessionId], references: [id], onDelete: SetNull)

  title String

  destinationId String?      @db.Uuid
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  /// What the traveller called the place, kept even when `destinationId` is
  /// null or later repointed. "Cox's Bazar & Saint Martin's" is a valid label
  /// with no single catalog row behind it.
  destinationLabel String

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  totalDays Int
  partySize Int

  purpose             TripPurpose         @default(VACATION)
  pace                TripPace            @default(BALANCED)
  transportPreference TransportPreference @default(MIXED)
  budgetBand          BudgetBand?

  status ItineraryStatus @default(DRAFT)

  coverImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days     ItineraryDay[]
  /// Quotation conversations about this trip.
  quotes   Quote[]
  /// Checkouts opened against this trip — a payment that failed or was
  /// abandoned appears here too.
  payments Payment[]

  @@index([userId, status])
  @@index([destinationId])
  @@index([plannerSessionId])
  @@map("itineraries")
}

model ItineraryDay {
  id String @id @default(uuid(7)) @db.Uuid

  itineraryId String    @db.Uuid
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  /// 1-based. Day 1 is the first day of the trip, not an index.
  dayNumber Int

  date  DateTime? @db.Date
  title String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks ItineraryBlock[]

  /// Free-tier truncation and paid unlock both work by day number, so
  /// duplicates would make "the first 2 days" ambiguous.
  @@unique([itineraryId, dayNumber])
  @@map("itinerary_days")
}

model ItineraryBlock {
  id String @id @default(uuid(7)) @db.Uuid

  dayId String       @db.Uuid
  day   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  kind ItineraryBlockKind

  /// Set for kind = ACTIVITY, and it must point at a real catalog row: this FK
  /// is what stops the model inventing inventory. SetNull rather than Cascade
  /// so retiring an activity does not silently delete a booked plan.
  activityId String?   @db.Uuid
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  title       String
  description String?

  /// Minutes from local midnight. `endMinute` may exceed 1440 for a block that
  /// runs past midnight; the migration enforces endMinute > startMinute.
  startMinute Int
  endMinute   Int

  transitMode TransitMode?

  /// For a TRANSIT block, the block being travelled away from — this is how the
  /// Gantt draws the connector.
  transitFromBlockId String?          @db.Uuid
  transitFromBlock   ItineraryBlock?  @relation("BlockTransit", fields: [transitFromBlockId], references: [id], onDelete: SetNull)
  transitTo          ItineraryBlock[] @relation("BlockTransit")

  /// Pinned by the traveller. Regeneration must plan around a locked block
  /// rather than move it.
  isLocked Boolean @default(false)

  /// True when WE computed this block rather than a person authoring it —
  /// today that means an auto-inserted TRANSIT block whose duration came from a
  /// straight-line distance estimate rather than from a routing service. The
  /// planner may recompute or drop its own estimates freely; it must never
  /// touch a block a traveller placed. Without this column the two are
  /// indistinguishable, and "resync the transfers" quietly deletes the ferry
  /// time somebody typed in by hand.
  isEstimate Boolean @default(false)

  sortOrder Int @default(0)

  /// Whole BDT for the whole block (already multiplied by party size where
  /// that applies), null when nothing is charged.
  costBdt Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayId, startMinute])
  @@index([activityId])
  @@index([transitFromBlockId])
  @@map("itinerary_blocks")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI spend
//
// One row per model call, written by every surface that talks to a provider.
//
// It exists because nothing else could answer "what did we spend, on which
// model". PlannerMessage carries `model` and token counts, but only for the
// planner, and only for calls that produced a message — a teaser, a refusal, a
// provider timeout and a cache hit all leave no trace there at all. A console
// built on that table would have reported the cheap model as free and an
// outage as quiet.
//
// Deliberately append-only and never updated. It is a spend log; a row that can
// be edited is a row that cannot be reconciled against an invoice.
// ─────────────────────────────────────────────────────────────────────────────

/// Which product surface made the call. The unit ops budgets by.
enum AiSurface {
  /// The one free preview an anonymous visitor gets.
  TEASER
  /// A conversational planner turn.
  PLANNER
  /// Rebuilding a single day of an existing itinerary.
  DAY_REGENERATION
  /// Ranking or suggesting catalog activities.
  SUGGESTION

  // ── Journey planner ───────────────────────────────────────────────────────
  //
  // Separate from the values above so the console can answer which feature is
  // spending. A funnel running eight model calls per trip is not comparable to
  // a planner running one per turn, and folding them together makes the first
  // month's bill unattributable.

  /// Parsing one typed sentence into trip fields, before sign-in.
  JOURNEY_INTAKE
  /// Drafting the day-by-day skeleton.
  JOURNEY_SKELETON
  /// Merging a message into a preference brief.
  JOURNEY_BRIEF
  /// Ranking real provider candidates against a brief.
  JOURNEY_RANKER
  /// Estimating a transfer between two places.
  JOURNEY_TRANSFER
  /// A turn of the main itinerary chat.
  JOURNEY_CHAT
  /// Asking which format of a packaged tour somebody wants.
  JOURNEY_ELICITOR
}

enum AiCallOutcome {
  SUCCEEDED
  /// Reached the provider and came back wrong: a timeout, a 5xx, a schema miss.
  FAILED
  /// Never reached the provider. A quota wall, a kill switch, a cache hit.
  /// Costs nothing, and is recorded precisely so the money saved is visible.
  REFUSED
}

model AiUsageEvent {
  id String @id @default(uuid(7)) @db.Uuid

  surface AiSurface
  outcome AiCallOutcome

  /// Recorded as free text rather than an enum. Model names are a vendor's
  /// vocabulary, not ours — `gemini-flash-latest` resolves to something new
  /// whenever Google says so — and a migration per model rename would make the
  /// spend log the thing blocking a model swap.
  provider String
  model    String

  /// Where the selection came from: `env`, `setting` or `explicit`. Ops needs
  /// to see at a glance whether a console override is actually in force.
  modelSource String

  /// True when the reply came from TeaserCache and no provider was called.
  /// The row is still written: "how often did the cache save us a call" is the
  /// question that justifies the cache, and it cannot be answered by rows that
  /// were never written.
  cached Boolean @default(false)

  /// Null whenever the provider did not report them — a failure, a refusal, or
  /// a stream that aborted. Null is not zero, and averaging over it as zero
  /// would understate cost exactly when something is going wrong.
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  /// Wall clock for the call, including retries inside the SDK.
  latencyMs Int?

  /// `AbortError`, `AI_APICallError`, and so on. The class of failure, never
  /// the message: provider messages can quote the prompt back, and this table
  /// is read by staff who have no business reading a traveller's words.
  errorKind String?

  /// SetNull on all three: a deleted account or an expired session must not
  /// erase what was spent on it.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  anonymousVisitorId String?           @db.Uuid
  anonymousVisitor   AnonymousVisitor? @relation(fields: [anonymousVisitorId], references: [id], onDelete: SetNull)

  plannerSessionId String?         @db.Uuid
  plannerSession   PlannerSession? @relation(fields: [plannerSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// The console's questions, in index form: what happened lately, what did
  /// each model cost, which surface is spending, and who.
  @@index([createdAt])
  @@index([model, createdAt])
  @@index([surface, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Packages
//
// The Discover catalogue: trips ops has already designed, as opposed to the
// ones the planner builds on demand. Two axes decide how one is sold and both
// are columns rather than conventions, because the website branches on them:
//
//   scope       DOMESTIC or INTERNATIONAL — the two tabs on /discover.
//   pricingMode FIXED_PRICE, which quotes a number, or INTEREST_ONLY, which
//               collects a list of people who would come if it ran.
//
// An INTEREST_ONLY package with a price is a contradiction, and the migration
// adds a CHECK that says so.
// ─────────────────────────────────────────────────────────────────────────────

enum PackageScope {
  DOMESTIC
  INTERNATIONAL
}

enum PackageKind {
  /// Fixed departures, a shared group, a leader assigned.
  GROUP
  /// Run for one party, on dates they choose.
  INDIVIDUAL
}

enum PackagePricingMode {
  /// `priceFromBdt` is a real number somebody may book against.
  FIXED_PRICE
  /// Not costed yet. The public page collects interest instead of a booking.
  INTEREST_ONLY
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DepartureStatus {
  SCHEDULED
  /// Enough seats sold that it runs whatever happens next.
  GUARANTEED
  SOLD_OUT
  CANCELLED
  COMPLETED
}

enum TripLeaderRole {
  /// Runs the trip on the ground.
  LEADER
  /// Owns it commercially; the name on the quote.
  MANAGER
  /// Local specialist for part of it.
  GUIDE
}

enum PackageInterestStatus {
  NEW
  CONTACTED
  CONVERTED
  WITHDRAWN
}

model TravelPackage {
  id String @id @default(uuid(7)) @db.Uuid

  slug  String @unique
  title String

  /// One or two lines for the card. `description` is the page.
  summary     String
  description String

  scope       PackageScope
  kind        PackageKind
  pricingMode PackagePricingMode

  /// Optional link to the catalog, so a package can point at the destination
  /// whose activities the planner already knows. SetNull, never Cascade:
  /// retiring a destination must not delete a package people have booked.
  destinationId String?      @db.Uuid
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  /// What the card prints. Kept even when `destinationId` is null, exactly as
  /// on Itinerary: "Sylhet & Srimangal" is a real trip with no single row.
  destinationLabel String
  country          String

  durationDays   Int
  durationNights Int

  /// Whole taka, per person, and NULL for INTEREST_ONLY — not zero. Zero is a
  /// free trip, which is a thing we could run and therefore must stay
  /// distinguishable from "no price yet".
  priceFromBdt Int?
  /// Set only when the price genuinely is a range across departures or room
  /// grades. Null means `priceFromBdt` is the price.
  priceToBdt   Int?

  /// GROUP only. The band the trip runs in, shown on the card as "8–14
  /// travellers" so nobody has to open the page to learn it is a small group.
  groupSizeMin Int?
  groupSizeMax Int?

  heroImageUrl String?
  cardImageUrl String?

  /// Short bullets. Postgres arrays rather than tables: they are ordered
  /// display strings with no identity of their own, nothing joins to them, and
  /// a three-table write to save a bullet point is a worse trade than
  /// rewriting the whole array.
  highlights String[]
  inclusions String[]
  exclusions String[]

  status      PackageStatus @default(DRAFT)
  publishedAt DateTime?
  sortOrder   Int           @default(0)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departures PackageDeparture[]
  days       PackageItineraryDay[]
  leaders    PackageLeader[]
  interests  PackageInterest[]
  /// Times this package has actually run and been written up.
  pastTrips  PastTrip[]
  bookings   PackageBooking[]
  /// Codes restricted to this trip. A code with no package works on any of them.
  coupons    Coupon[]

  /// The public list query: published rows of one scope, in curator order.
  @@index([status, scope, sortOrder])
  @@index([destinationId])
  @@map("travel_packages")
}

/// One dated running of a package. This is what a traveller actually joins.
model PackageDeparture {
  id String @id @default(uuid(7)) @db.Uuid

  packageId String        @db.Uuid
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  capacity   Int
  /// Held seats. Never derived from a count of interests — an interest is not a
  /// seat, and conflating the two would let a waiting list close a departure.
  seatsTaken Int @default(0)

  /// Overrides the package price for this departure. Peak dates cost more, and
  /// a second price column beats editing the package twice a year.
  priceBdt Int?

  status DepartureStatus @default(SCHEDULED)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interests PackageInterest[]
  pastTrips PastTrip[]
  bookings  PackageBooking[]

  /// One departure per package per start date. A duplicate is a data-entry
  /// slip, and two rows for one trip split its seat count in half.
  @@unique([packageId, startDate])
  @@index([startDate, status])
  @@map("package_departures")
}

/// A day of the published itinerary. Shown in full on the public page — the
/// day-by-day IS the product description for a package.
model PackageItineraryDay {
  id String @id @default(uuid(7)) @db.Uuid

  packageId String        @db.Uuid
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  /// 1-based, like ItineraryDay. Day 1 is the first day, not an index.
  dayNumber Int

  title   String
  summary String?

  /// Where they sleep that night. Null on the last day, when they do not.
  accommodation String?

  /// "Breakfast", "Dinner". An array, because the answer is a list and the
  /// question is never "which meal row is this".
  meals String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PackageItineraryItem[]

  @@unique([packageId, dayNumber])
  @@map("package_itinerary_days")
}

/// A line within a published day.
model PackageItineraryItem {
  id String @id @default(uuid(7)) @db.Uuid

  dayId String              @db.Uuid
  day   PackageItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  /// Reuses the planner's vocabulary rather than inventing a second one, so a
  /// package day and a generated day can render through the same component.
  kind ItineraryBlockKind @default(ACTIVITY)

  title  String
  detail String?

  /// Minutes from local midnight, the same convention as ItineraryBlock, and
  /// nullable here because a published itinerary is often deliberately vague:
  /// "afternoon at leisure" has no start time and must not be given a fake one.
  startMinute     Int?
  durationMinutes Int?

  position Int @default(0)

  @@index([dayId, position])
  @@map("package_itinerary_items")
}

/// Staff who run trips. A table of people rather than three text columns on a
/// package, because the same guide leads eleven trips and their photo should
/// not be uploaded eleven times.
model TripLeader {
  id String @id @default(uuid(7)) @db.Uuid

  slug String @unique
  name String

  /// Their usual role. A package may override it — the person who leads most
  /// trips occasionally goes along as the local guide.
  role TripLeaderRole @default(LEADER)

  /// One line under the name. "Twelve years in the Sundarbans."
  headline String
  bio      String

  photoUrl String?

  yearsExperience Int?
  /// Curated, not counted: it includes the years before this system existed.
  tripsLed        Int  @default(0)

  languages String[]

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages  PackageLeader[]
  /// Trips they actually led, as opposed to packages they are assigned to.
  pastTrips PastTripLeader[]

  @@index([isActive, sortOrder])
  @@map("trip_leaders")
}

model PackageLeader {
  id String @id @default(uuid(7)) @db.Uuid

  packageId String        @db.Uuid
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  leaderId String     @db.Uuid
  leader   TripLeader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  /// Overrides TripLeader.role for this trip only.
  role TripLeaderRole

  /// The name on the card. At most one per package, enforced by a partial
  /// unique index in the migration — Prisma cannot express one.
  isPrimary Boolean @default(false)

  sortOrder Int @default(0)

  @@unique([packageId, leaderId])
  @@index([leaderId])
  @@map("package_leaders")
}

/// "I would come on this." The join list for an INTEREST_ONLY package, and the
/// enquiry list for a priced one.
model PackageInterest {
  id String @id @default(uuid(7)) @db.Uuid

  packageId String        @db.Uuid
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  /// Which running of it, when they picked one.
  departureId String?           @db.Uuid
  departure   PackageDeparture? @relation(fields: [departureId], references: [id], onDelete: SetNull)

  /// Set when they were signed in. Null for a visitor who left an address.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name  String
  /// Lowercased and trimmed before write, like User.email, since the unique
  /// index below is case-sensitive and "Ana@x.com" must not register twice.
  email String
  phone String?

  partySize Int     @default(1)
  message   String?

  status PackageInterestStatus @default(NEW)

  /// Set when ops last spoke to them. Ordering the console by this is how a
  /// list of leads stops being a list of names.
  contactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One registration per address per package. Registering twice is a
  /// double-click, not two travellers — and the public card prints this count,
  /// so a duplicate would inflate the number the whole feature is selling.
  @@unique([packageId, email])
  @@index([packageId, status])
  @@index([departureId])
  @@map("package_interests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Polls
//
// "Where should we go next?" on the Discover page. Results are hidden until
// somebody votes, which is the product rule and also the anti-herding one.
//
// One vote per voter per poll is a UNIQUE constraint, not a check in a service.
// A poll whose numbers can be inflated by opening a second tab is a poll whose
// numbers are worthless, and the only place that guarantee can live is the
// database.
// ─────────────────────────────────────────────────────────────────────────────

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}

model Poll {
  id String @id @default(uuid(7)) @db.Uuid

  slug     String @unique
  question String

  description String?

  status PollStatus @default(DRAFT)

  /// A window, so a poll can be scheduled and can close itself. Both null means
  /// "open until somebody closes it".
  opensAt  DateTime?
  closesAt DateTime?

  /// Off by default: seeing the leader before choosing changes the choice.
  showResultsBeforeVote Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options PollOption[]
  votes   PollVote[]

  @@index([status, sortOrder])
  @@map("polls")
}

model PollOption {
  id String @id @default(uuid(7)) @db.Uuid

  pollId String @db.Uuid
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  label    String
  subtitle String?
  imageUrl String?

  sortOrder Int @default(0)

  /// Denormalised so a results read is one row per option rather than a
  /// group-by over every vote ever cast. Incremented in the same transaction as
  /// the vote, so it cannot drift; PollVote remains the record of truth and the
  /// console can recount from it.
  voteCount Int @default(0)

  createdAt DateTime @default(now())

  votes PollVote[]

  /// Exists only to be referenced by a composite foreign key.
  ///
  /// `id` is already unique on its own, so this adds no restriction. What it
  /// adds is a target: `poll_votes` carries a FK on (optionId, pollId) pointing
  /// here, which is what stops a vote naming poll A and option B. Postgres
  /// requires the referenced columns to be unique together, and Prisma cannot
  /// express the composite FK itself — so the constraint lives in the migration
  /// and this line is here to stop `migrate dev` proposing to drop the index
  /// underneath it.
  @@unique([id, pollId])
  @@index([pollId, sortOrder])
  @@map("poll_options")
}

model PollVote {
  id String @id @default(uuid(7)) @db.Uuid

  pollId String @db.Uuid
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  optionId String     @db.Uuid
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  anonymousVisitorId String?           @db.Uuid
  anonymousVisitor   AnonymousVisitor? @relation(fields: [anonymousVisitorId], references: [id], onDelete: SetNull)

  /// The identity this vote is deduplicated on: `u:<userId>` for an account,
  /// `v:<visitorId>` for a recognised visitor, `ip:<salted digest>` otherwise.
  ///
  /// A derived column rather than a pair of nullable FKs, because the
  /// constraint has to hold across all three cases at once and Postgres cannot
  /// make one unique index span "whichever of these is set". Signing in after
  /// voting anonymously is therefore two different keys — deliberately: the
  /// alternative is refusing a genuine first vote from an account because a
  /// stranger on the same office router already voted.
  voterKey String

  createdAt DateTime @default(now())

  /// The guarantee. Nothing above this line is trusted to enforce it.
  @@unique([pollId, voterKey])
  @@index([optionId])
  @@map("poll_votes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Past trips
//
// The trips we have already run, published as a public record.
//
// A PastTrip is NOT a TravelPackage. A package is a thing we sell — it may have
// run twenty times or never. A past trip is one specific running of one, with
// the people who were actually on it, what actually happened, and what they
// thought of it afterwards. `packageId` links the two where a link exists, and
// is nullable because the earliest trips predate the catalogue.
//
// WHAT MAKES THIS WORTH PUBLISHING RATHER THAN A GALLERY
//
// Two things, and both are deliberate discomfort:
//
//   INCIDENTS. `TripHighlight.kind` includes INCIDENT alongside MOMENT, so the
//   ferry that was cancelled and the day it rained through appear beside the
//   sunrise. A page that records only the good parts is a brochure, and readers
//   discount brochures entirely.
//
//   RATINGS ON SEVEN AXES, not one star. A trip can have superb guiding and bad
//   food, and a single number averages that into "4.1" — a figure that tells
//   nobody whether to book. One row per dimension per review is the only shape
//   that keeps the two facts apart.
// ─────────────────────────────────────────────────────────────────────────────

enum PastTripStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TripHighlightKind {
  /// The thing people will tell their friends about.
  MOMENT
  /// The thing that went wrong. Published on purpose — see the block comment.
  INCIDENT
  /// A first, a summit, a record. Something the group achieved.
  MILESTONE
}

/// What a review scores. Adding a value here is a migration and a deliberate
/// act: every historical review is then silently missing the new axis, and an
/// average computed across a dimension most reviews never saw is a lie with a
/// decimal point in it.
enum ReviewDimension {
  ORGANISATION
  ACCOMMODATION
  FOOD
  TRANSPORT
  VALUE_FOR_MONEY
  TRIP_LEADER
  ACTIVITIES
}

/// Anything a traveller submitted starts here and stays invisible until a human
/// says otherwise. There is no fourth state and no auto-approve flag.
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PastTrip {
  id String @id @default(uuid(7)) @db.Uuid

  slug  String @unique
  title String

  /// One or two lines for the card.
  summary String

  /// The long account of how it went. Written by whoever led it.
  story String

  /// The package this was a running of, where there is one. SetNull rather than
  /// Cascade: retiring a package must not delete the record of the trips that
  /// actually happened under it.
  packageId String?        @db.Uuid
  package   TravelPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  /// The exact departure, while we still have the row. Also SetNull.
  departureId String?           @db.Uuid
  departure   PackageDeparture? @relation(fields: [departureId], references: [id], onDelete: SetNull)

  /// Denormalised from the package so a trip whose package was deleted still
  /// says where it went, and so the card needs no join.
  destinationLabel String
  country          String
  scope            PackageScope

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// How many people travelled. A curated total, not a count of rows: most
  /// travellers never made an account, and a figure derived from
  /// `participants` would under-report every trip by most of its group.
  memberCount Int

  heroImageUrl String?

  status      PastTripStatus @default(DRAFT)
  publishedAt DateTime?
  sortOrder   Int            @default(0)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaders      PastTripLeader[]
  participants TripParticipant[]
  highlights   TripHighlight[]
  media        TripMedia[]
  reviews      TripReview[]

  /// The public list: published trips, most recent first.
  @@index([status, startDate])
  @@index([packageId])
  @@map("past_trips")
}

/// Who ran it. Separate from PackageLeader because the person who led a trip in
/// March is not necessarily the one assigned to the package today.
model PastTripLeader {
  id String @id @default(uuid(7)) @db.Uuid

  tripId String   @db.Uuid
  trip   PastTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  leaderId String     @db.Uuid
  leader   TripLeader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  role TripLeaderRole

  sortOrder Int @default(0)

  @@unique([tripId, leaderId])
  @@index([leaderId])
  @@map("past_trip_leaders")
}

/// Somebody who was on the trip.
///
/// This table exists to answer exactly one question: may this account leave a
/// review? Reviews are restricted to people who went, and "went" has to be a
/// row somewhere or the restriction is a comment. Rows are created by ops from
/// the booking list, never by a traveller claiming to have been there.
model TripParticipant {
  id String @id @default(uuid(7)) @db.Uuid

  tripId String   @db.Uuid
  trip   PastTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// Set once we can match them to an account. Null for a traveller who never
  /// made one — they still travelled, they just cannot review.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name  String
  /// Lowercased and trimmed, like every other email column here.
  email String

  createdAt DateTime @default(now())

  /// One row per person per trip. Also what makes the review gate a single
  /// indexed lookup rather than a scan.
  @@unique([tripId, email])
  @@index([userId])
  @@map("trip_participants")
}

model TripHighlight {
  id String @id @default(uuid(7)) @db.Uuid

  tripId String   @db.Uuid
  trip   PastTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  kind TripHighlightKind

  title String
  body  String

  /// Which day it happened on, when that is known. Null for something that ran
  /// through the whole trip.
  dayNumber Int?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([tripId, sortOrder])
  @@map("trip_highlights")
}

/// A photograph in a trip's gallery.
///
/// Uploaded by travellers or by staff, and INVISIBLE until approved. The
/// default is PENDING and no code path sets APPROVED without an admin id beside
/// it — a public gallery anyone can write to is a public gallery somebody
/// eventually writes something unpleasant into.
model TripMedia {
  id String @id @default(uuid(7)) @db.Uuid

  tripId String   @db.Uuid
  trip   PastTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  url     String
  /// Never empty on an approved row: alt text is not optional on a public page.
  alt     String
  caption String?

  /// Who sent it. Null for staff uploads and for a deleted account — the photo
  /// survives, the attribution does not.
  uploadedByUserId String? @db.Uuid
  uploadedByUser   User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  moderationStatus ModerationStatus @default(PENDING)

  /// Who decided, and when. Kept for the same reason a payment keeps its
  /// verifier: "why is this on the site" needs an answer with a name in it.
  reviewedByAdminId String?    @db.Uuid
  reviewedByAdmin   AdminUser? @relation("TripMediaModerator", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  /// Shown to the uploader, never published.
  rejectionReason   String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  /// The public read: approved rows for one trip, in curator order.
  @@index([tripId, moderationStatus, sortOrder])
  @@index([moderationStatus, createdAt])
  @@map("trip_media")
}

/// One traveller's verdict on one trip: prose, plus a score per dimension.
model TripReview {
  id String @id @default(uuid(7)) @db.Uuid

  tripId String   @db.Uuid
  trip   PastTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// Required, unlike everywhere else. A review is only meaningful if we can
  /// say it came from somebody who went, and that check runs against an
  /// account. Cascade: deleting an account takes its opinions with it.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the public page prints in large type.
  headline String
  /// The feedback itself.
  body     String

  /// How they want to be credited. Null falls back to the account's name.
  displayName String?

  moderationStatus ModerationStatus @default(PENDING)

  reviewedByAdminId String?    @db.Uuid
  reviewedByAdmin   AdminUser? @relation("TripReviewModerator", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings TripReviewRating[]

  /// One review per person per trip. Editing yours replaces it; a second
  /// opinion is not a second voice, and the averages would double-count it.
  @@unique([tripId, userId])
  @@index([tripId, moderationStatus])
  @@index([moderationStatus, createdAt])
  @@map("trip_reviews")
}

/// One score, on one axis, from one review.
///
/// A row per dimension rather than seven columns. Columns would mean a
/// migration to ask a new question and a NULL on every historical row to answer
/// it — and NULL in a numeric column is exactly the value that gets averaged as
/// zero by somebody in a hurry. A missing row is missing, and an average over
/// rows cannot silently include it.
model TripReviewRating {
  id String @id @default(uuid(7)) @db.Uuid

  reviewId String     @db.Uuid
  review   TripReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  dimension ReviewDimension

  /// 1 to 5, enforced by a CHECK in the migration. Integers only: half-stars
  /// are a rendering decision, not a thing a traveller should have to express.
  score Int

  /// One score per dimension per review. Without this, a client that retried a
  /// submission would double the weight of whichever axis it resent.
  @@unique([reviewId, dimension])
  @@index([dimension])
  @@map("trip_review_ratings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking a departure
//
// Buying a seat on a dated group trip, as opposed to unlocking an itinerary or
// subscribing. `PaymentPurpose.BOOKING` has existed since the payments module
// was written and did nothing; this is what it now points at.
//
// THE SEAT IS HELD AT BOOKING, NOT AT SETTLEMENT
//
// A booking claims its seats the moment it is created, before anybody pays.
// The alternative — claim on settlement — lets two travellers both reach a
// payment page for the last seat, and one of them pays for something that no
// longer exists. Holding early costs an abandoned checkout tying up a seat for
// a while, and that is the cheaper failure by a wide margin.
//
// EVERY MONEY COLUMN IS A SNAPSHOT
//
// `unitPriceBdt`, `subtotalBdt`, `discountBdt` and `totalBdt` are written once,
// at booking time, and never recomputed. A departure repriced next week must not
// change what somebody already agreed to pay, and a coupon that expires must not
// retroactively raise a total. The price on a booking is a promise; the price on
// a departure is an offer.
// ─────────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  /// Seats are held, nothing is paid. Cancelling releases them.
  PENDING_PAYMENT
  /// Paid for. The seats stay held.
  CONFIRMED
  /// Released the seats. Reachable from either state above.
  CANCELLED
  /// Money returned after confirmation. Seats already released.
  REFUNDED
}

model PackageBooking {
  id String @id @default(uuid(7)) @db.Uuid

  /// Short human code, e.g. `BB-7F3K2Q`. What a traveller quotes on the phone
  /// and what appears on their receipt. Unique, and never reused.
  reference String @unique

  /// SetNull rather than Cascade, exactly like Payment: a deleted account must
  /// not erase the record of a trip that ran and was paid for.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Restrict on both. A package or departure with bookings against it is one
  /// that was sold; deleting the row out from under the financial record would
  /// leave "they paid ৳62,000 for something" with no way to say what.
  packageId String        @db.Uuid
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  departureId String           @db.Uuid
  departure   PackageDeparture @relation(fields: [departureId], references: [id], onDelete: Restrict)

  /// Seats held. Also the multiplier on the price.
  partySize Int

  /// Whole taka per person, as it stood when this was booked — the departure's
  /// override if it had one, otherwise the package price.
  unitPriceBdt Int
  /// `unitPriceBdt * partySize`. Stored rather than derived, so a later change
  /// to either input cannot silently restate an agreed figure.
  subtotalBdt  Int
  /// What the coupon took off, in whole taka. Zero when none was used.
  discountBdt  Int @default(0)
  /// `subtotalBdt - discountBdt`. What is actually charged.
  totalBdt     Int

  status BookingStatus @default(PENDING_PAYMENT)

  /// Who to contact. Kept on the booking rather than read from the account,
  /// because somebody books for their parents and the account is theirs.
  contactName  String
  /// Lowercased and trimmed, like every other email column here.
  contactEmail String
  contactPhone String?

  notes String?

  confirmedAt        DateTime?
  cancelledAt        DateTime?
  /// Why it was cancelled. Shown to the traveller.
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments   Payment[]
  redemption CouponRedemption?

  @@index([userId, status])
  @@index([departureId, status])
  @@index([status, createdAt])
  @@map("package_bookings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Coupons
//
// A discount code, and the record of every time one was used.
//
// The redemption row is what makes the limits real. `redeemedCount` on the
// coupon is a denormalisation for the console; `coupon_redemptions` is the
// record of truth, it is UNIQUE on the booking, and the per-account ceiling is
// counted from it rather than trusted to a column somebody could edit.
// ─────────────────────────────────────────────────────────────────────────────

enum CouponType {
  /// `value` is a percentage, 1–100. `maxDiscountBdt` caps what it takes off.
  PERCENT
  /// `value` is whole taka off the subtotal.
  FIXED
}

model Coupon {
  id String @id @default(uuid(7)) @db.Uuid

  /// Always uppercase. A CHECK enforces it, because the lookup is exact and
  /// "earlybird" not matching "EARLYBIRD" is the single most predictable
  /// support ticket a coupon feature can generate.
  code String @unique

  /// What a traveller sees when it applies, e.g. "Early bird — 15% off".
  label       String
  description String?

  type  CouponType
  /// 1–100 for PERCENT, whole taka for FIXED. A CHECK bounds both.
  value Int

  /// Ceiling on a PERCENT discount, in whole taka. Null means uncapped, which
  /// should be a decision rather than a default — 20% of a ৳112,000 trip is
  /// ৳22,400.
  maxDiscountBdt Int?
  /// Smallest subtotal this may be used against.
  minSpendBdt    Int?

  /// The window. Both null means it runs until somebody switches it off.
  startsAt DateTime?
  endsAt   DateTime?

  /// Total redemptions allowed across everybody. Null is unlimited.
  maxRedemptions Int?
  /// Per account. Defaults to one, which is what a promo code usually means.
  maxPerUser     Int  @default(1)

  /// Denormalised for the console's list view. `coupon_redemptions` is the
  /// record of truth, and the ceiling is enforced against it rather than this.
  redeemedCount Int @default(0)

  /// Restrict this code to one trip. Null means it works on any of them.
  packageId String?        @db.Uuid
  package   TravelPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive, endsAt])
  @@index([packageId])
  @@map("coupons")
}

model CouponRedemption {
  id String @id @default(uuid(7)) @db.Uuid

  couponId String @db.Uuid
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  /// Null for a booking made without an account. The per-account ceiling then
  /// cannot bind, which is why a code with `maxPerUser` set should also carry a
  /// `maxRedemptions` — see the validation service.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// One redemption per booking. The unique is what stops a retried request
  /// discounting the same booking twice.
  bookingId String         @unique @db.Uuid
  booking   PackageBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// What it actually took off, in whole taka. Recorded rather than recomputed:
  /// the coupon's terms may change afterwards, and this is what was given.
  discountBdt Int

  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Quotations
//
// A traveller finishes an itinerary and asks what it would actually cost. Ops
// prices it — real hotel names, real transport, real numbers — and sends it
// back. The traveller accepts, or asks for changes and ops sends a new version.
//
// WHY REVISIONS RATHER THAN AN EDITABLE QUOTE. A price somebody has been shown
// is a thing they may have decided on. Editing it in place would mean the row
// that said 84,000 taka yesterday says 96,000 today with nothing recording that
// it moved, and no way to answer "what was I quoted?" — which is the entirety of
// what a pricing dispute consists of. Each version is written once and frozen
// the moment it is sent.
// ─────────────────────────────────────────────────────────────────────────────

enum QuoteStatus {
  REQUESTED // traveller asked; nobody has priced it yet
  PRICED // ops has drafted numbers but not sent them
  SENT // the traveller can see it
  ACCEPTED
  DECLINED
  WITHDRAWN // ops pulled it; the row survives
  EXPIRED
}

model Quote {
  id String @id @default(uuid(7)) @db.Uuid

  /// Nullable and SetNull, exactly like `Payment.userId`.
  ///
  /// A quote is a commercial record: what was offered, for how much, and when.
  /// Cascading from the account would let somebody delete the evidence of a
  /// price they were given, which is the record a dispute is made of.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Nullable for the same reason. A traveller may delete a trip they have
  /// already been quoted for; the quote outlives it.
  itineraryId String?    @db.Uuid
  itinerary   Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: SetNull)

  status QuoteStatus @default(REQUESTED)

  /// What the traveller said when asking. Their words, not a form's.
  travellerNote String?

  requestedAt DateTime  @default(now())
  /// When it was accepted or declined. Null while it is still open.
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions QuoteRevision[]

  /// One OPEN quote per itinerary — a second request for the same trip is the
  /// same conversation, not a new one. Enforced as a partial unique index in
  /// the migration, because Prisma cannot express `WHERE status IN (...)`.
  @@index([status, requestedAt])
  @@index([userId])
  @@map("quotes")
}

model QuoteRevision {
  id String @id @default(uuid(7)) @db.Uuid

  quoteId String @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// 1-based. Version 2 exists because the traveller asked for changes.
  version Int

  /// Whole taka, like every other amount here. The CHECK in the migration is
  /// what makes `total = subtotal - discount` a guarantee rather than a
  /// convention every write site has to remember.
  subtotalBdt Int
  discountBdt Int @default(0)
  totalBdt    Int

  /// What the price does and does not cover, as ops wrote it.
  inclusions String[]
  exclusions String[]
  terms      String?

  /// A note to the traveller alongside the numbers.
  travellerMessage String?

  /// After this the price is no longer being held.
  validUntil DateTime?

  /// When the traveller was shown this version.
  ///
  /// NULL MEANS DRAFT, AND IT IS THE WHOLE INTEGRITY MECHANISM. Every write to
  /// a revision carries `sentAt: null` in its WHERE clause, so a version
  /// somebody has already been shown cannot be edited by any code path — the
  /// update simply matches no row. Changing a sent price means writing a new
  /// version, which is what the unique on (quoteId, version) is for. A database
  /// trigger enforces the same rule, because a predicate somebody forgets to
  /// write is not a rule.
  sentAt DateTime?

  /// Which admin priced it. Attribution, never authorisation.
  pricedByAdminId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quoteId, version])
  @@index([quoteId, sentAt])
  @@map("quote_revisions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Place imports
// ─────────────────────────────────────────────────────────────────────────────

enum PlaceCandidateStatus {
  /// Imported from Google, nobody has looked at it.
  PENDING
  /// A curator turned it into a real Activity. `activityId` points at it.
  APPROVED
  /// A curator decided we will not sell it. `rejectedReason` says why.
  REJECTED
}

/// A venue Google knows about, waiting for a human to decide whether we sell it.
///
/// A SEPARATE TABLE FROM `activities`, AND THAT IS THE WHOLE POINT. The planner
/// may only ever recommend rows from `activities` — a foreign key on
/// `itinerary_blocks.activityId` enforces it — so nothing in here can reach a
/// traveller by accident, by a forgotten `isActive` check, or by a query
/// somebody writes later without knowing this table exists. Approval MOVES data
/// across that boundary rather than flipping a flag inside it.
///
/// The reason curation is mandatory rather than fussy: Google answers "does this
/// place exist and where is it", and an Activity has to answer "what is it, how
/// long does it take, what does it cost in taka, and when is it worth doing".
/// Nothing in the Places response carries the last four. A row imported straight
/// into the catalogue would be a venue we cannot price, cannot schedule and have
/// never seen.
///
/// WHAT IS STORED HERE IS A CACHE WITH A SHELF LIFE. Google's terms permit
/// keeping `place_id` indefinitely but only limited, temporary retention of the
/// rest. `importedAt` is what makes that auditable, and the approved Activity is
/// written from the CURATOR'S prose rather than copied from Google's — so the
/// catalogue is our content, and this table is scaffolding that can be emptied.
model PlaceCandidate {
  id String @id @default(uuid(7)) @db.Uuid

  /// Google's stable identifier. Unique, so re-running the same search does not
  /// pile up duplicates of a place somebody has already judged — including one
  /// already REJECTED, which is the case that matters: a rejection has to stick.
  googlePlaceId String @unique

  /// Which destination this was searched under. The approved Activity inherits
  /// it, and an Activity cannot exist without one.
  destinationId String      @db.Uuid
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  /// Exactly as Google returned it. Never shown to a traveller — the curator
  /// writes the name that ships, because "Hotel Sea Crown Ltd." is a company
  /// registration rather than something to put on an itinerary.
  name             String
  formattedAddress String?
  /// Google's own type strings, e.g. `tourist_attraction`. Kept verbatim because
  /// the mapping to our ActivityCategory is a guess this table should not bake in.
  googleTypes      String[]
  rating           Decimal? @db.Decimal(2, 1)
  userRatingCount  Int?
  /// Google's 0–4 band. Not a price: PRICE_LEVEL_MODERATE says nothing about taka.
  priceLevel       String?
  websiteUri       String?
  googleMapsUri    String?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// Opening hours as Google phrases them, for the curator to read while filling
  /// in ours. Not parsed on import — a weekday string is not a schedule.
  openingHoursText String?

  /// What was typed to find this, kept so a curator can tell a deliberate import
  /// from a stray result on a broad search.
  searchQuery String

  status         PlaceCandidateStatus @default(PENDING)
  rejectedReason String?

  /// Set when APPROVED. SetNull rather than Cascade: deleting an activity should
  /// not erase the record that somebody imported and approved it.
  activityId String?   @unique @db.Uuid
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  /// Who decided, and when. Null while PENDING.
  reviewedByAdminId String?    @db.Uuid
  reviewedBy        AdminUser? @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?

  /// When Google's copy of this was fetched. The retention clock.
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, importedAt])
  @@index([destinationId, status])
  @@map("place_candidates")
}

// ─────────────────────────────────────────────────────────────────────────────
// Journey — the AI itinerary planner (Idea Gen spec)
//
// A SECOND PLANNER, deliberately parallel to Itinerary/ItineraryDay/
// ItineraryBlock rather than an evolution of it. The two answer different
// questions and are wanted side by side:
//
//   Itinerary  — the curated planner. Every activity is a catalogue row we can
//                book, enforced by a foreign key. Nothing else may appear.
//   Journey    — the quotation funnel. Items may come from Viator, Google
//                Places or an AI estimate, because what is sold here is a
//                QUOTATION rather than a booking: every figure is an estimate,
//                and the admin replaces it with a real vendor price.
//
// Mixing them would mean either weakening the catalogue guarantee or crippling
// the funnel, so they stay separate tables with separate rules.
//
// Named Journey rather than Trip because Trip* already belongs to the past-trips
// showcase (TripHighlight, TripLeader, TripMedia, TripParticipant, TripReview).
// ─────────────────────────────────────────────────────────────────────────────

enum JourneyStatus {
  PLANNING
  QUOTATION_REQUESTED
  QUOTED
  ACCEPTED
}

/// When the traveller wants to go, before they commit to dates.
enum DateBucket {
  NEXT_WEEK
  TWO_TO_FOUR_WEEKS
  NEXT_MONTH
  CUSTOM
}

/// Humans plan in day-parts, not timestamps. Exact times are optional on top.
enum DaySlot {
  MORNING
  AFTERNOON
  EVENING
}

enum JourneyItemType {
  ACTIVITY
  STAY
  FOOD
  TRANSFER
}

/// Whether the traveller chose this or we proposed it.
///
/// The admin has to be able to tell the difference: an item the customer
/// actively pinned is a requirement, and one we suggested is a starting point
/// they merely did not object to. Quoting those the same way is how you replace
/// the one thing they cared about.
enum ItemOrigin {
  USER_PINNED
  AI_SUGGESTED
}

/// Where an item's facts came from.
///
/// AI_ESTIMATE is the only value that is not a real external record, and it
/// exists for transfers, which no free source covers well. Every other value
/// names a provider whose data can be checked.
enum ItemSource {
  VIATOR
  GOOGLE_PLACES
  CURATED
  AI_ESTIMATE
}

enum BriefPillar {
  STAY
  ACTIVITY
  FOOD
  TRANSPORT
}

enum BudgetScope {
  TOTAL_TRIP
  PER_PERSON
  PER_NIGHT
}

/// One planned trip, from first sentence to accepted quotation.
model Journey {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null while a visitor is still being parsed anonymously. Set the moment they
  /// sign in, which is what carries the parsed trip through the auth wall.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Read-only public link. Unguessable, and the only way an unauthenticated
  /// co-traveller sees the plan — viewing needs no account, editing does.
  shareToken String @unique

  title String?

  /// Free text as the traveller typed it, kept verbatim. The parse is a
  /// derivative and can be re-run; the original sentence cannot be rebuilt.
  rawIntake String?

  /// Several, in order. A multi-city trip is exactly the case that makes
  /// transfers matter, so this is a list rather than one column.
  destinations String[]

  durationDays Int
  dateBucket   DateBucket @default(CUSTOM)
  startDate    DateTime?  @db.Date
  endDate      DateTime?  @db.Date

  partyAdults   Int     @default(2)
  partyChildren Int     @default(0)
  /// couple | family | friends | solo | group. Free text because the model
  /// parses it from a sentence, and an enum would reject the ones nobody
  /// anticipated.
  partyType     String?

  tripType  String?
  interests String[]

  /// Whole taka. Null when the traveller has not said, which is common and has
  /// to stay distinguishable from "no budget at all".
  budgetMinBdt Int?
  budgetMaxBdt Int?
  budgetScope  BudgetScope @default(TOTAL_TRIP)

  status JourneyStatus @default(PLANNING)

  /// Set when a quotation is requested. Pricing, revisions and sending stay in
  /// the existing Quote model, which already owns all three.
  quoteId String? @db.Uuid

  contactWhatsapp      String?
  contactEmail         String?
  contactPreferredTime String?
  userNotes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  JourneyItem[]
  briefs PreferenceBrief[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@map("journeys")
}

/// One thing on one day.
model JourneyItem {
  id String @id @default(uuid(7)) @db.Uuid

  journeyId String  @db.Uuid
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  /// 1-based. Day 1 is the first day of the trip, not an index.
  dayNumber Int
  slot      DaySlot

  /// Minutes from local midnight, when the traveller set an exact time. Null
  /// means "somewhere in this slot", which is how most of a plan gets written.
  startMinute Int?
  /// Typical length. Used with the slot to decide whether two items collide.
  durationMin Int?

  type   JourneyItemType
  origin ItemOrigin      @default(AI_SUGGESTED)

  source     ItemSource @default(AI_ESTIMATE)
  /// Viator product code, Google place id, or null for an estimate.
  externalId String?

  /// Set only when the item is a real catalogue row. SetNull, so retiring an
  /// activity does not delete somebody's plan.
  activityId String?   @db.Uuid
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  title       String
  description String?

  /// EVERY PRICE IS A RANGE, AND EVERY RANGE IS AN ESTIMATE. What is sold here
  /// is a quotation; these numbers exist to set expectations and fill a budget
  /// meter, and the admin replaces them with real vendor prices.
  estPriceMinBdt Int?
  estPriceMaxBdt Int?
  /// person | group | night | trip
  estPricePer    String?

  /// At most fifteen words, echoing the traveller's own stated preferences.
  /// What makes a suggestion feel chosen rather than dredged up.
  matchReason String?

  locationName String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  /// What the provider said at the moment this was picked — image, rating,
  /// duration, deep link.
  ///
  /// SNAPSHOTTED RATHER THAN RE-FETCHED. A quotation is priced against what the
  /// traveller was looking at, so a tour that changes price or disappears next
  /// week must not silently change what they asked for. It is also what lets a
  /// plan render without calling Viator on every page load.
  snapshot Json?

  /// The preference brief this was chosen against. Kept after the pick, so the
  /// admin sees both what was chosen and what was actually wanted.
  briefId String?          @db.Uuid
  brief   PreferenceBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId, dayNumber, slot])
  @@index([activityId])
  @@map("journey_items")
}

/// What the traveller wants from one pillar in one place — the curated prompt.
///
/// THE FLAGSHIP FEATURE, and the thing the admin actually consumes. Every chat
/// message about hotels in Phuket merges into this one structured brief instead
/// of scrolling away as prose. It survives a concrete pick on purpose: knowing
/// the customer chose one hotel AND wanted "3-star plus, pool, quiet end of
/// Patong, 4-6k a night" is what lets the admin substitute something better with
/// confidence.
model PreferenceBrief {
  id String @id @default(uuid(7)) @db.Uuid

  journeyId String  @db.Uuid
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  pillar   BriefPillar
  /// Free text, matching how a traveller names places rather than a destination
  /// id — "Patong" is a brief location and not a catalogue row.
  location String
  nights   Int?

  /// star_min, location_hints[], budget_per_night{min,max}, amenities[], notes[]
  /// Json, because the shape differs per pillar and the model writes it.
  constraints Json

  /// At most twenty-five words. What the chips say, in one sentence.
  summary String

  /// Every message that shaped this brief, oldest first. Kept so a curator can
  /// see how a constraint arrived, and so a bad merge is diagnosable.
  history Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items JourneyItem[]

  /// One brief per pillar per place. A second would split the constraints, and
  /// the ranker would read half of them.
  @@unique([journeyId, pillar, location])
  @@map("preference_briefs")
}

/// The agency's own transfer knowledge, for routes no free API covers well.
///
/// A hand-maintained table beats every free source on exactly the routes most
/// travellers take, because the agency has actually sold them. The AI estimator
/// is the fallback for everything else, and says so by marking itself
/// low-confidence.
model RouteEstimate {
  id String @id @default(uuid(7)) @db.Uuid

  /// Lowercased on write so "Krabi" and "krabi" are one route. A CHECK enforces
  /// it, because a duplicate route is a second answer to one question.
  fromLocation String
  toLocation   String

  /// bus | train | minivan | private_car | taxi | ferry | flight
  mode String

  durationMinMinutes Int
  durationMaxMinutes Int

  priceMinBdt Int
  priceMaxBdt Int
  /// person | vehicle
  pricePer    String @default("person")

  note String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per route per mode — a bus and a private car are different answers
  /// to the same question, and both should be offerable.
  @@unique([fromLocation, toLocation, mode])
  @@index([fromLocation, toLocation, isActive])
  @@map("route_estimates")
}

/// Provider responses, cached because the free tiers are small and an estimate
/// does not need to be fresh.
///
/// Viator's terms expect product data to be cached and refreshed periodically
/// rather than called per page view, so this is alignment with their rules and
/// not merely an optimisation. Google Places bills per call, and its
/// Enterprise-tier fields — rating, photos — carry roughly a thousand free calls
/// a month; without this, one busy afternoon spends the month.
model ProviderCache {
  /// sha256 of provider + endpoint + normalised request. The whole key, so a
  /// lookup is a primary-key hit rather than a scan.
  cacheKey String @id

  provider String
  endpoint String

  payload Json

  fetchedAt DateTime @default(now())
  /// Rows past this are ignored on read and swept later. A column rather than a
  /// constant, because search results and attraction records have very
  /// different useful lives.
  expiresAt DateTime

  @@index([expiresAt])
  @@index([provider, endpoint])
  @@map("provider_cache")
}
