# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Prisma 7 reads this via prisma.config.ts (dotenv).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ON SUPABASE, use the POOLER host, not `db.<ref>.supabase.co`. Direct
# connections resolve to IPv6 only, so a network without IPv6 fails with
# ENOTFOUND before it ever reaches Postgres. The pooler is reachable on IPv4:
#
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Port 5432 is session mode — keep it. Port 6543 is transaction mode, which
# breaks the prepared statements and advisory locks `prisma migrate` relies on.
#
# `sslmode=require` means "encrypt, do not verify the CA" — libpq's meaning, and
# what `connectionFor()` in src/lib/db.ts implements. Use `verify-full` (with
# NODE_EXTRA_CA_CERTS pointing at the provider's CA) if the server should be
# authenticated as well as the traffic encrypted.

# ── Auth ───────────────────────────────────────────────────────────────────
# Signing secrets for JWTs. Generate with: openssl rand -base64 48
# Users and admins are signed with SEPARATE secrets so a leaked user token can
# never be replayed against an admin route, and rotating one does not log out the other.
AUTH_USER_SECRET="change-me-min-32-chars-generate-with-openssl-rand-base64-48"
AUTH_ADMIN_SECRET="change-me-min-32-chars-different-from-the-user-secret-above"

# Token lifetimes
AUTH_ACCESS_TTL_SECONDS=900        # 15 minutes
AUTH_REFRESH_TTL_SECONDS=2592000   # 30 days

# Absolute ceiling on a single login, regardless of how often it is refreshed.
# Rotation slides the refresh window forward, so without this bound one stolen
# token refreshed monthly would grant access forever.
AUTH_SESSION_MAX_SECONDS=7776000   # 90 days

# ── Payments: the sandbox gateway ──────────────────────────────────────────
# A dummy provider that mimics an online payment so the purchase flows can be
# tested end to end without a merchant account. It settles on a button press
# and moves no money — but it grants REAL entitlements, so treat these two
# variables as the paywall's on/off switch, because that is what they are.
#
# Every payment it writes carries `isTest = true` in the database, and the
# admin console badges those rows. Revenue reporting must filter them out.
#
# Accepted values: true/false, 1/0, yes/no, on/off, enabled/disabled
# (case-insensitive). Anything else fails the boot rather than being guessed at.
#
# Whether the sandbox gateway may be used at all.
# UNSET means true in development and FALSE in every other NODE_ENV, including
# test. Leaving it unset locally is the intended way to run it.
PAYMENTS_MOCK_ENABLED=true

# The second, independent key to the same door.
#
# Under NODE_ENV=production the sandbox refuses to initiate or settle unless
# BOTH this and PAYMENTS_MOCK_ENABLED are true. Two variables, because one is
# too easy to flip by accident: env files get copied between deployments
# wholesale, and a second flag means the accident has to happen twice — to two
# differently-named variables, one of which says PRODUCTION out loud.
#
# There is no legitimate reason to set this on a deployment that takes real
# money. If you are setting it, you should be able to say why in one sentence
# to whoever owns the revenue number.
PAYMENTS_ALLOW_MOCK_IN_PRODUCTION=false

# ── AI ─────────────────────────────────────────────────────────────────────
# Provider is swappable at runtime; a `settings` row overrides these defaults.
AI_PROVIDER="google"

# The conversational model. It must follow instructions reliably: the planner's
# catalog-only rule and its refusal to disclose its own prompt are carried by
# the prompt, not by a schema, so a model that treats instructions loosely
# cannot hold them.
#
# NOTE: `gemini-2.5-flash` was the default here until Google retired it for new
# keys — it now answers "no longer available to new users".
AI_MODEL="gemini-flash-latest"

# Optional cheaper model, used ONLY where a JSON schema forces the output shape
# (the anonymous teaser today). Unset falls back to AI_MODEL, which is safe.
#
# Deliberately not a Gemma model, which is the obvious candidate. Measured on
# `gemma-4-31b-it`: told to reply with one word it narrates the instruction back
# instead — in the system and user roles alike, since it has no system role on
# this API — and while it handles a trivial schema it timed out past five
# minutes on the real teaser schema, which flash-lite returns in under a second.
AI_MODEL_CHEAP="gemini-3.1-flash-lite"

GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Public URLs ────────────────────────────────────────────────────────────
# Where the public site lives; used for CORS and links in transactional email.
PUBLIC_WEB_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"

# ── Network edge ───────────────────────────────────────────────────────────
# How many reverse proxies YOU operate in front of this process.
#
# Proxies APPEND the peer they saw to the right of `x-forwarded-for`, so the
# leftmost entry is whatever the caller typed and the rightmost entries are
# ours. This count is how clientContext() finds the boundary: the client is
# `xff[length - TRUSTED_PROXY_HOPS]`, and a chain shorter than that resolves to
# no IP at all rather than to a value we cannot vouch for.
#
# 0 means "trust nothing" and is the right answer when this process is reached
# directly — it resolves no client IP, which is the honest result. Anonymous
# callers then share one rate-limit pool (see server/http/rate-limit.ts)
# instead of each being handed their own allowance for free.
#
# Count the hops, do not guess. Behind one nginx that sets X-Forwarded-For it
# is 1; behind Cloudflare in front of that nginx it is 2. Setting it higher
# than reality costs you the IP signal. Setting it LOWER than reality hands the
# quota key back to the attacker, which is the bug this variable exists to fix.
TRUSTED_PROXY_HOPS=0

# Google Places (New) — optional.
# Powers the catalogue import screen at /places. Without it that screen says so
# and nothing else changes. Enable "Places API (New)" in Google Cloud, not the
# legacy Places API — this app calls places.googleapis.com/v1.
# SERVER-SIDE ONLY. Never expose as NEXT_PUBLIC_*: a Places key in a browser
# bundle is a key anybody can spend.
GOOGLE_PLACES_API_KEY=""
